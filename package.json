{
  "name": "nighttreks-portfolio",
  "version": "1.8.0",
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": "24.x",
    "pnpm": "9.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rimraf .next out",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "eslint . --ext .js,.jsx,.ts,.tsx --fix && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "check-types": "next typegen && tsc --noEmit --pretty",
    "audit": "pnpm audit --audit-level moderate",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "framer-motion": "12.40.0",
    "next": "16.2.6",
    "next-sitemap": "4.2.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "autoprefixer": "10.4.22",
    "cssnano": "7.1.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-tailwindcss": "3.18.3",
    "eslint-plugin-unused-imports": "4.4.1",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "braces@<3.0.3": "3.0.3",
      "cross-spawn@>=7.0.0 <7.0.6": "7.0.6",
      "diff@>=4.0.0 <4.0.4": "4.0.4",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "micromatch@<4.0.8": "4.0.8",
      "flatted@<3.4.2": "3.4.2",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "nanoid@<3.3.8": "3.3.8",
      "picomatch@<2.3.2": "2.3.2",
      "postcss@<8.5.10": "8.5.15",
      "yaml@>=2.0.0 <2.8.3": "2.8.3"
    }
  },
  "author": "nighttrek (https://github.com/nighttrek)"
}
